# Firebase Analytics (Task.md §31). Скопируйте в `.env` (не коммитится,
# см. .gitignore) и заполните значениями из консоли Firebase — Project
# settings → General → Your apps → SDK setup and configuration.
#
# Без этих переменных приложение работает нормально, но Firebase Analytics
# остаётся выключенным (см. src/analytics/analytics.ts) — это ожидаемое
# поведение для локальной разработки без своего Firebase-проекта.
#
# В Vercel эти же переменные задаются в Project Settings → Environment
# Variables (для Production/Preview/Development по необходимости).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
